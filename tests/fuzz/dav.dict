# libFuzzer dictionary for FuzzDAV : mock HTTP response format, WebDAV /
# CalDAV / GroupDAV XML and URLs. `make fuzz-dav` appends ical.dict.

########## Mock response format (see FuzzDAV.m) ##########
dav_separator="\x0a=====\x0a"
dav_eoh="\x0a\x0a"
dav_eoh_crlf="\x0d\x0a\x0d\x0a"
dav_200="200 OK\x0a"
dav_201="201 Created\x0a"
dav_204="204 No Content\x0a"
dav_207="207 Multi-Status\x0a"
dav_0="0\x0a"
dav_301="301 Moved Permanently\x0a"
dav_302="302 Found\x0a"
dav_304="304 Not Modified\x0a"
dav_401="401 Unauthorized\x0a"
dav_403="403 Forbidden\x0a"
dav_404="404 Not Found\x0a"
dav_412="412 Precondition Failed\x0a"
dav_500="500 Internal Server Error\x0a"
dav_599="599\x0a"

########## Headers read by WebDAVResource ##########
hdr_location="Location: "
hdr_etag="ETag: "
hdr_last_modified="Last-Modified: "
hdr_content_type="Content-Type: "
etag_quoted="\x22abc\x22"
etag_weak="W/\x22abc\x22"
http_date="Mon, 04 Mar 2024 10:00:00 GMT"

########## URLs ##########
url_mock="mock://example.org/"
url_http="http://"
url_https="https://"
url_webcal="webcal://"
url_file="file:///"
url_creds="user:pass@"
url_at="@"
url_dotdot="../"
url_slashslash="//"
url_query="?a=b"
url_fragment="#frag"
url_pct="%2F"
url_pct_bad="%"
url_pct_zero="%00"
url_ipv6="[::1]"
url_port=":8080"
url_space=" "
well_known="/.well-known/caldav"

########## XML ##########
xml_decl="<?xml version=\x221.0\x22 encoding=\x22utf-8\x22?>"
xml_ns_dav="xmlns:D=\x22DAV:\x22"
xml_ns_dav_default="xmlns=\x22DAV:\x22"
xml_ns_caldav="xmlns:C=\x22urn:ietf:params:xml:ns:caldav\x22"
xml_ns_groupdav="xmlns:G=\x22http://groupdav.org/\x22"
xml_multistatus="<D:multistatus xmlns:D=\x22DAV:\x22>"
xml_multistatus_end="</D:multistatus>"
xml_response="<D:response>"
xml_response_end="</D:response>"
xml_href="<D:href>"
xml_href_end="</D:href>"
xml_propstat="<D:propstat>"
xml_propstat_end="</D:propstat>"
xml_prop="<D:prop>"
xml_prop_end="</D:prop>"
xml_status="<D:status>HTTP/1.1 200 OK</D:status>"
xml_status_404="<D:status>HTTP/1.1 404 Not Found</D:status>"
xml_getetag="<D:getetag>"
xml_getetag_end="</D:getetag>"
xml_getlastmodified="<D:getlastmodified>"
xml_getlastmodified_end="</D:getlastmodified>"
xml_resourcetype="<D:resourcetype>"
xml_resourcetype_end="</D:resourcetype>"
xml_collection="<D:collection/>"
xml_calendar="<C:calendar/>"
xml_vevent_collection="<G:vevent-collection/>"
xml_vtodo_collection="<G:vtodo-collection/>"
xml_principal="<D:current-user-principal>"
xml_principal_end="</D:current-user-principal>"
xml_home_set="<C:calendar-home-set>"
xml_home_set_end="</C:calendar-home-set>"
xml_empty_elt="<D:href/>"
xml_cdata="<![CDATA["
xml_cdata_end="]]>"
xml_comment="<!-- -->"
xml_pi="<?pi data?>"
xml_doctype="<!DOCTYPE multistatus ["
xml_entity="<!ENTITY e \x22"
xml_entity_system="<!ENTITY e SYSTEM \x22"
xml_entity_ref="&e;"
xml_amp="&amp;"
xml_lt="&lt;"
xml_charref="&#x41;"
xml_charref_bad="&#0;"
xml_attr="a=\x22b\x22"
xml_xmlns_empty="xmlns=\x22\x22"
xml_xmlns_prefix="xmlns:"
