# libFuzzer / AFL dictionary for iCalendar (RFC 5545), focused on what
# SimpleAgenda reads in Element.m, Event.m, Task.m, Alarm.m, Date.m and
# RecurrenceRule.m.

########## Structure ##########
crlf="\x0d\x0a"
fold="\x0d\x0a "
fold_tab="\x0d\x0a\x09"
lf="\x0a"
colon=":"
semicolon=";"
comma=","
equal="="
dquote="\x22"
nul="\x00"

begin="BEGIN:"
end="END:"
begin_vcalendar="BEGIN:VCALENDAR"
end_vcalendar="END:VCALENDAR"
begin_vevent="BEGIN:VEVENT"
end_vevent="END:VEVENT"
begin_vtodo="BEGIN:VTODO"
end_vtodo="END:VTODO"
begin_valarm="BEGIN:VALARM"
end_valarm="END:VALARM"
begin_vtimezone="BEGIN:VTIMEZONE"
end_vtimezone="END:VTIMEZONE"
begin_standard="BEGIN:STANDARD"
end_standard="END:STANDARD"
begin_daylight="BEGIN:DAYLIGHT"
end_daylight="END:DAYLIGHT"
begin_vjournal="BEGIN:VJOURNAL"
begin_vfreebusy="BEGIN:VFREEBUSY"
comp_vcalendar="VCALENDAR"
comp_vevent="VEVENT"
comp_vtodo="VTODO"
comp_valarm="VALARM"

########## Calendar properties ##########
version="VERSION:2.0"
prodid="PRODID:"
method="METHOD:"
method_publish="METHOD:PUBLISH"
method_request="METHOD:REQUEST"
calscale="CALSCALE:GREGORIAN"

########## Properties read by Element / Event / Task ##########
uid="UID:"
dtstamp="DTSTAMP:"
dtstart="DTSTART:"
dtend="DTEND:"
due="DUE:"
duration="DURATION:"
summary="SUMMARY:"
description="DESCRIPTION:"
location="LOCATION:"
categories="CATEGORIES:"
class="CLASS:"
status="STATUS:"
rrule="RRULE:"
exdate="EXDATE:"
rdate="RDATE:"
percent="PERCENT-COMPLETE:"
priority="PRIORITY:"
sequence="SEQUENCE:"
last_modified="LAST-MODIFIED:"
created="CREATED:"
tzid_prop="TZID:"
tzoffsetfrom="TZOFFSETFROM:"
tzoffsetto="TZOFFSETTO:"

########## Alarm properties (Alarm.m) ##########
action="ACTION:"
trigger="TRIGGER:"
repeat="REPEAT:"
attendee="ATTENDEE:"
attach="ATTACH:"
mailto="mailto:"

########## SimpleAgenda / vendor X-properties ##########
x_allday="X-MICROSOFT-CDO-ALLDAYEVENT:"
x_allday_true="X-MICROSOFT-CDO-ALLDAYEVENT:TRUE"
x_allday_false="X-MICROSOFT-CDO-ALLDAYEVENT:FALSE"
x_sticky="X-SIMPLEAGENDA-STICKY:"
x_sticky_true="X-SIMPLEAGENDA-STICKY:TRUE"
x_prefix="X-"
x_lic_error="X-LIC-ERROR:"

########## Parameters ##########
p_value="VALUE="
p_value_date=";VALUE=DATE"
p_value_datetime=";VALUE=DATE-TIME"
p_value_duration=";VALUE=DURATION"
p_value_period=";VALUE=PERIOD"
p_value_binary=";VALUE=BINARY"
p_tzid=";TZID="
p_tzid_paris=";TZID=Europe/Paris"
p_tzid_quoted=";TZID=\x22/mozilla.org/Europe/Paris\x22"
p_related_start=";RELATED=START"
p_related_end=";RELATED=END"
p_encoding=";ENCODING=BASE64"
p_fmttype=";FMTTYPE="
p_cn=";CN="
p_partstat=";PARTSTAT="
p_role=";ROLE="
p_language=";LANGUAGE="
p_altrep=";ALTREP="

########## Enumerated values ##########
class_public="PUBLIC"
class_private="PRIVATE"
class_confidential="CONFIDENTIAL"
status_needs_action="NEEDS-ACTION"
status_in_process="IN-PROCESS"
status_completed="COMPLETED"
status_cancelled="CANCELLED"
status_tentative="TENTATIVE"
status_confirmed="CONFIRMED"
action_display="DISPLAY"
action_audio="AUDIO"
action_email="EMAIL"
action_procedure="PROCEDURE"
true="TRUE"
false="FALSE"

########## RRULE parts (RecurrenceRule.m) ##########
freq="FREQ="
freq_secondly="FREQ=SECONDLY"
freq_minutely="FREQ=MINUTELY"
freq_hourly="FREQ=HOURLY"
freq_daily="FREQ=DAILY"
freq_weekly="FREQ=WEEKLY"
freq_monthly="FREQ=MONTHLY"
freq_yearly="FREQ=YEARLY"
interval=";INTERVAL="
count=";COUNT="
until=";UNTIL="
byday=";BYDAY="
bymonthday=";BYMONTHDAY="
byyearday=";BYYEARDAY="
byweekno=";BYWEEKNO="
