day_neg53="-53SU"
monthday_neg="-31"
yearday_366="366"
weekno_53="53"
setpos_neg="-366"
interval_zero="0"
count_huge="2147483647"
num_neg="-1"

########## Date / time values (Date.m) ##########
date="20240315"
datetime="20240315T100000"
datetime_utc="20240315T100000Z"
date_leap="20240229"
date_bad_leap="20230229"
date_dec31="20241231T235959Z"
date_epoch="19700101T000000Z"
date_y2038="20380119T031408Z"
date_year0="00000101"
date_far="99991231T235959Z"
leap_second="20161231T235960Z"
hour24="20240315T240000"
date_zero="00000000T000000"
offset_plus="+0100"
offset_minus="-0500"
offset_bad="+2500"
period="/"

########## Durations ##########
dur_1h="PT1H"
dur_15m="PT15M"
dur_neg_15m="-PT15M"
dur_1d="P1D"
dur_1w="P1W"
dur_mixed="P1DT2H3M4S"
dur_zero="PT0S"
dur_huge="P99999999W"
dur_neg_huge="-P99999999D"

########## Text escapes and encodings ##########
esc_n="\x5cn"
esc_N="\x5cN"
esc_comma="\x5c,"
esc_semicolon="\x5c;"
esc_backslash="\x5c\x5c"
esc_dangling="\x5c"
utf8_e_acute="\xc3\xa9"
utf8_euro="\xe2\x82\xac"
utf8_emoji="\xf0\x9f\x93\x85"
utf8_truncated="\xe2\x82"
